# Database Configuration
# SQLite (development / single-user desktop)
DATABASE_URL=sqlite:///./data/stock_analyzer.db

# PostgreSQL (production / always-on updater)
# DATABASE_URL=postgresql://alphalens:your_password@localhost:5432/alphalens

# Twelve Data API
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# The free plan serves no JSE symbols (needs Pro) - set false to use Yahoo only
TWELVE_DATA_ENABLED=true

# Yahoo Finance (no API key required for basic usage)
YFINANCE_ENABLED=true

# EasyEquities (unofficial client - uses your account login, not an API key)
EASYEQUITIES_USERNAME=your_easyequities_username
EASYEQUITIES_PASSWORD=your_easyequities_password

# Luno - crypto holdings sync. Use a READ-ONLY key (balance view only).
# Same names as the luno-mcp server, so one key pair serves both.
LUNO_API_KEY_ID=your_luno_api_key_id
LUNO_API_SECRET=your_luno_api_secret

# Moneyweb - required for Home top movers and the Dividend Watch calendar
MONEYWEB_USERNAME=your_moneyweb_username
MONEYWEB_PASSWORD=your_moneyweb_password

# GoldAPI.io (free 100 req/month sandbox)
GOLD_API_KEY=your_goldapi_access_token_here
GOLD_API_BASE_URL=https://www.goldapi.io

# Metals.dev (live commodity spot) + Alpha Vantage (commodity history)
METALS_DEV_API_KEY=your_metals_dev_api_key_here
METALS_DEV_BASE_URL=https://api.metals.dev/v1/latest
METALS_DEV_CURRENCY=ZAR
METALS_DEV_UNIT=g
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Company News (optional - NewsData.io free tier)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Updater Service Configuration (scripts/run_updater.py)
SCHEDULER_TIMEZONE=Africa/Johannesburg

# RSS Feed URLs
RSS_MONEYWEB=https://www.moneyweb.co.za/feed/
RSS_BUSINESSTECH=https://businesstech.co.za/news/feed/
RSS_NEWS24_BUSINESS=https://feeds.capi24.com/v1/Search/articles/news24/Business/rss
RSS_DAILY_INVESTOR=https://www.dailyinvestor.com/feed/
RSS_IOL_BUSINESS=https://iol.co.za/rss/iol/business

# Caching Configuration
CACHE_TTL_SECONDS=3600

# Database backups (taken by the updater daemon)
BACKUP_DIR=./data/backups
BACKUP_KEEP=8
BACKUP_INTERVAL_DAYS=7
# Blank = auto-detect pg_dump on PATH or under C:\Program Files\PostgreSQL\*\bin
PG_DUMP_PATH=

# Notification Configuration
NOTIFICATION_ENABLED=false
NOTIFICATION_EMAIL_SMTP_HOST=smtp.gmail.com
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_FROM=your_email@gmail.com
NOTIFICATION_EMAIL_PASSWORD=your_app_password
NOTIFICATION_NTFY_TOPIC=your_ntfy_topic
NOTIFICATION_DISCORD_WEBHOOK_URL=your_discord_webhook_url
NOTIFICATION_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NOTIFICATION_TELEGRAM_CHAT_ID=your_telegram_chat_id
# Near-52-week-low alerts for sub-R5 JSE shares (daily, after the historical job)
PENNY_LOW_ALERT_ENABLED=true
PENNY_LOW_ALERT_PCT=10

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Updater Service Configuration
UPDATER_LOGON_MIN_INTERVAL=600
UPDATER_LOG_FILE=./data/logs/updater.log

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# JSE Configuration
JSE_INDEX_YF_SYMBOL=^J203.JO
DEFAULT_WATCHLIST=NPN,CFR,AGL,SOL,SBK
