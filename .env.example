# Database Configuration
DATABASE_URL=sqlite:///./data/stock_analyzer.db

# Twelve Data API
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Yahoo Finance (no API key required for basic usage)
YFINANCE_ENABLED=true

# Financial Modeling Prep API
FMP_API_KEY=your_fmp_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Johannesburg
HOURLY_UPDATE_HOUR=*
HOURLY_UPDATE_MINUTE=0

# RSS Feed URLs
RSS_MONEYWEB=https://www.moneyweb.co.za/feed/
RSS_BUSINESSTECH=https://businesstech.co.za/news/feed/
RSS_NEWS24_BUSINESS=https://www.news24.com/Services/Site/Feeds/24/Article/TopStories?sectionId=3
RSS_DAILY_INVESTOR=https://www.dailyinvestor.com/feed/

# Caching Configuration
CACHE_TYPE=diskcache
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=3600

# Notification Configuration
NOTIFICATION_ENABLED=false
NOTIFICATION_EMAIL_SMTP_HOST=smtp.gmail.com
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_FROM=your_email@gmail.com
NOTIFICATION_EMAIL_PASSWORD=your_app_password
NOTIFICATION_NTFY_TOPIC=your_ntfy_topic
NOTIFICATION_DISCORD_WEBHOOK_URL=your_discord_webhook_url
NOTIFICATION_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NOTIFICATION_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# JSE Configuration
JSE_INDEX_SYMBOL=J203
DEFAULT_WATCHLIST=NPN,CFR,AGL,SOL,SBK
